# AI Fairness Lab — Environment Variables
#
# Copy this file to .env (or configure on your deployment platform)
# and fill in the required values.
#
# IMPORTANT: Never commit .env to version control.
# This file (.env.example) is safe to commit — it contains no real keys.
#
# ─────────────────────────────────────────────────────────────────────
# OPERATION MODE
# ─────────────────────────────────────────────────────────────────────

# Set to "demo" for the default reliable classroom experience.
# Set to "live" to enable real API calls.
# Can also be overridden via URL: ?mode=live
FAIRNESS_LAB_MODE=demo

# ─────────────────────────────────────────────────────────────────────
# MODEL API KEYS
# (Only required when FAIRNESS_LAB_MODE=live)
# ─────────────────────────────────────────────────────────────────────

# Model A — replace with your actual provider key
# Currently mapped to: Microsoft Azure Computer Vision / Face API
MODEL_A_API_KEY=your_model_a_key_here
MODEL_A_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Model B — replace with your actual provider key
# Currently mapped to: Face++ (Megvii)
MODEL_B_API_KEY=your_model_b_key_here
MODEL_B_API_SECRET=your_model_b_secret_here

# Model C — replace with your actual provider key
# Currently mapped to: IBM Watson Visual Recognition
MODEL_C_API_KEY=your_model_c_key_here
MODEL_C_ENDPOINT=https://api.us-south.visual-recognition.watson.cloud.ibm.com/instances/your-instance

# ─────────────────────────────────────────────────────────────────────
# HOW TO ADD A NEW MODEL PROVIDER
# ─────────────────────────────────────────────────────────────────────
#
# 1. Add environment variables for the new provider above.
# 2. Create a new backend handler in /api/adapters/<provider>.js
#    (or equivalent server-side file)
# 3. In the backend /api/predict endpoint, add a routing case for the
#    new modelKey.
# 4. The frontend ModelAdapter in app.js requires no changes — it
#    sends { testCaseId, modelKey } and receives { prediction, confidence, correct }.
#
# The frontend NEVER contains API keys. All authentication happens
# in the backend /api/predict endpoint.
